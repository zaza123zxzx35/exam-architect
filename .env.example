# Server-side only (never prefix with VITE_)
# Local: copy to .env / .env.local (gitignored) and restart `npm run dev`
# Vercel: Project Settings → Environment Variables (Production / Preview / Development)

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000

# Do NOT set VITE_OPENAI_API_KEY — client bundles must never receive the key.
